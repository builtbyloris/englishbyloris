# Public Supabase project values from Project Settings > API.
# These values are safe to expose to the browser and remain protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Never add a Supabase secret key or legacy service_role key to this file.
